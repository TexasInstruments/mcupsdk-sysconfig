/*
 * Include files for PMIC, I2C
 */
#include <string.h>
#include <drivers/i2c.h>
#include <kernel/dpl/DebugP.h>
#include "ti_drivers_config.h"
#include "ti_drivers_open_close.h"

/*
 * Macro definitions for PMIC R/W
 */

#define PMIC_I2C_ADDR							((uint8_t)0X60)
#define PMIC_WD_ENABLE_REG_REGADDR              ((uint8_t)0x0FU)
#define PMIC_WD_MODE_REG_REGADDR                ((uint8_t)0x10U)
#define PMIC_READ_FRAME_LEN						((uint8_t)0x4U)
#define PMIC_WRITE_FRAME_LEN					((uint8_t)0x3U)
#define PMIC_IO_BUF_SIZE						((uint8_t)0x4U)
#define PMIC_WD_LONG_WN_ENABLE					((uint8_t)0x5U)
#define PMIC_WD_RST_DISABLE						((uint8_t)0x1U)


/* PMIC Driver open/close - can be used by application when Board_driversOpen() and
 * Board_driversClose() is not used directly and app wants to control the various driver
 * open/close sequences */
int32_t Board_pmicOpen(void);
void Board_pmicClose(void);

/* Pmic_wdgResetDisable() - Disables watchdog reset */
int32_t Pmic_wdgResetDisable();

/* Pmic_readFromReg() - Function to read the watchdog enable register */
int32_t Pmic_readFromReg(uint8_t regAddr, uint8_t *rxData);

/* Pmic_writeToReg() - function to write to the watchdog enable register */
int32_t Pmic_writeToReg(uint8_t regAddr, uint8_t txData);
