%%{
    let module = system.modules['/sdl/stc/stc'];
%%}
/*
 * STC
 */
#include <kernel/dpl/HwiP.h>
#include <sdl/sdl_stc.h>

/*
 * Run the STC test. This should be run first before any other tests.
 */
int32_t SDL_stcRun()
{
    uint32_t key;
    int32_t retVal = 0;
    int32_t testResult = SDL_STC_NOT_RUN;
    SDL_STC_Config config;

    /* disable IRQ */
    key = HwiP_disable();

% for(let i = module.$instances.length-1 ; i >= 0; i--) {
    % let instance = module.$instances[i];
    % let config = module.getInstanceConfig(instance);
    testResult = SDL_STC_NOT_RUN;

    while (testResult == SDL_STC_NOT_RUN || testResult == SDL_STC_NOT_COMPLETED)
    {
        testResult = SDL_STC_getStatus(`config.stcInst`);

        switch (testResult)
        {
            case SDL_STC_COMPLETED_SUCCESS:
            {
                DebugP_log("Core `config.stcInst` is Reset.\r\n");
                DebugP_log("STC is done Successfully & Passed for `config.stcInst`.\r\n");
                break;
            }
            case SDL_STC_COMPLETED_FAILURE:
            {
                DebugP_log("Core `config.stcInst` is Reset.\r\n");
                DebugP_log("STC Test is Completed & failing.\r\n");
                retVal = SDL_EFAIL;
                break;
            }
            case SDL_STC_NOT_COMPLETED:
            {
                DebugP_log("STC Test is Active but Not yet Completed. \r\n");
                break;
            }
            case SDL_STC_NOT_RUN:
            {
                config.intervalNum=                         STC_MSS_INTERVAL_NUM;
                config.modeConfig.lpScanMode=               STC_MSS_LP_SCAN_MODE;
                config.modeConfig.codecSpreadMode=          STC_MSS_CODEC_SPREAD_MODE;
                config.modeConfig.capIdleCycle=             STC_MSS_CAP_IDLE_CYCLE;
                config.modeConfig.scanEnHighCap_idleCycle=  STC_MSS_SCANEN_HIGH_CAP_IDLE_CYCLE;
                config.maxRunTime=                          STC_MSS_MAX_RUN_TIME;
                config.clkDiv=                              STC_MSS_CLK_DIV;
                config.romStartAddress=                     STC_ROM_START_ADDRESS;
                config.pRomStartAdd=                        STC_pROM_START_ADDRESS;

                retVal = SDL_STC_selfTest(`config.stcInst`, SDL_STC_TEST, &config);

                if (retVal != SDL_PASS)
                {
                    DebugP_log("STC Test Could not completed Successfully.\r\n");
                }

                break;
            }
            case INVALID_RESULT:
            {
                DebugP_log("Something Invaild Input. \r\n");
                break;
            }
            default :
            break;
        }
    }
    if (testResult != SDL_STC_COMPLETED_SUCCESS)
    {
        retVal = SDL_EFAIL;
    }
% }

    HwiP_restore(key);
    return retVal;
}
